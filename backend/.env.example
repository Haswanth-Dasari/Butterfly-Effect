# Copy to .env and fill in real values. Never commit the real file (.gitignore already covers .env).

PORT=4000

PGHOST=localhost
PGPORT=5432
PGDATABASE=butterfly

# Player-facing connection: member of player_role (least privilege).
# Used for apply_action, ask_why, butterfly_score, current_tick, entity_state
# reads, look_back, and other per-player calls with app.actor_id set.
PG_APP_USER=butterfly_app
PG_APP_PASSWORD=change_me

# Game-master connection: member of game_master_role.
# Used only for join_village, advance_day, fork_branch, create_snapshot,
# refresh_daily_views, and branch/digest/audit reads. Never exposed to an
# untrusted client action directly; the routes that use it are the game's
# own admin/tick endpoints.
PG_GM_USER=butterfly_gm
PG_GM_PASSWORD=change_me

# Signs the session token that maps a browser session to an actor_id.
# Generate a real random value for deployment: openssl rand -hex 32
SESSION_SECRET=change_me_too
